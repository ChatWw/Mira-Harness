{
  "name": "mira",
  "version": "0.0.10",
  "description": "Mira personal tool application shell",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "platform",
    "personal-tools",
    "micro-frontend"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build && electron-builder --mac dmg --arm64"
  },
  "main": "out/main/main.js",
  "build": {
    "appId": "com.wujinbo.mira",
    "productName": "Mira",
    "icon": "src/asset/mira.icns",
    "win": {
      "icon": "src/asset/mira.ico"
    },
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "files": [
      "out/**/*",
      "src/asset/mira-logo.png"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/vue": "^5.0.1",
    "better-sqlite3": "^13.0.2",
    "element-plus": "^2.14.2",
    "ldrs": "^1.1.9",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-pro": "^3.28.2",
    "spinkit": "^2.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "wujie-vue3": "^2.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sass": "^1.101.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
