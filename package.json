{
  "name": "mira-harness",
  "version": "0.0.10",
  "description": "Mira Harness personal tool application shell",
  "productName": "Mira",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "platform",
    "personal-tools",
    "micro-frontend"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build && electron-builder --mac dmg --arm64",
    "desktop:build:win": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && electron-vite build && electron-rebuild --force --only better-sqlite3 --arch x64 --dist-url https://npmmirror.com/mirrors/electron/ && electron-builder --win nsis"
  },
  "main": "out/main/main.js",
  "build": {
    "appId": "com.wujinbo.mira",
    "productName": "Mira",
    "icon": "src/asset/mira.icns",
    "win": {
      "icon": "src/asset/mira.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerHeader": "build/installerHeader.bmp"
    },
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "files": [
      "out/**/*",
      "src/asset/mira-logo.png",
      "src/asset/mira.ico"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/vue": "^5.0.1",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wangeditor-next/editor": "^6.2.0",
    "@wangeditor-next/editor-for-vue": "^6.2.0",
    "better-sqlite3": "^13.0.2",
    "diff": "^8.0.4",
    "element-plus": "^2.14.2",
    "ldrs": "^1.1.9",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-pro": "^3.28.2",
    "spinkit": "^2.0.1",
    "turndown": "^7.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "wujie-vue3": "^2.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sass": "^1.101.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
